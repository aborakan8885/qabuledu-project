{
  "entities": {
    "Survey": {
      "title": "Survey",
      "description": "Beneficiary request or admission/transfer survey submitted by parents or citizens",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "beneficiaryName": { "type": "string", "maxLength": 200 },
        "nationalId": { "type": "string", "maxLength": 30 },
        "phoneNumber": { "type": "string", "maxLength": 30 },
        "parentName": { "type": "string", "maxLength": 200 },
        "problemType": { "type": "string", "maxLength": 100 },
        "schoolName": { "type": "string", "maxLength": 200 },
        "stage": { "type": "string", "maxLength": 50 },
        "grade": { "type": "string", "maxLength": 50 },
        "gender": { "type": "string", "enum": ["boys", "girls"] },
        "requestType": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 },
        "isResolved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "beneficiaryName", "createdAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Beneficiary inquiry or question submitted to admission officers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderName": { "type": "string", "maxLength": 200 },
        "senderPhone": { "type": "string", "maxLength": 30 },
        "inquiryText": { "type": "string", "maxLength": 3000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["new", "claimed", "answered"] },
        "officerReply": { "type": "string", "maxLength": 3000 },
        "answeredByOfficerId": { "type": "string", "maxLength": 100 },
        "answeredByOfficerName": { "type": "string", "maxLength": 200 },
        "beneficiaryRating": { "type": "number" },
        "beneficiaryFeedbackNotes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "senderName", "inquiryText", "createdAt"]
    },
    "PrincipalReport": {
      "title": "PrincipalReport",
      "description": "School principal report regarding school capacity or admission issues",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolCode": { "type": "string", "maxLength": 50 },
        "schoolName": { "type": "string", "maxLength": 200 },
        "principalName": { "type": "string", "maxLength": 200 },
        "principalPhone": { "type": "string", "maxLength": 30 },
        "reportType": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 3000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "schoolName", "createdAt"]
    },
    "School": {
      "title": "School",
      "description": "Madinah education department school catalog record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameAr": { "type": "string", "maxLength": 200 },
        "ministryCode": { "type": "string", "maxLength": 50 },
        "stage": { "type": "string", "maxLength": 50 },
        "gender": { "type": "string", "maxLength": 20 },
        "district": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "nameAr"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "System-wide settings and parameters",
      "type": "object",
      "properties": {
        "adminEmails": { "type": "string", "maxLength": 500 },
        "admissionSeasonActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/surveys/{surveyId}": {
      "schema": "Survey",
      "description": "Collection of all submitted admission and transfer requests"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Collection of all citizen inquiries and communication threads"
    },
    "/principal_reports/{reportId}": {
      "schema": "PrincipalReport",
      "description": "Collection of reports filed by school principals"
    },
    "/schools/{schoolId}": {
      "schema": "School",
      "description": "Collection of official school records"
    },
    "/system_config/{configId}": {
      "schema": "AppConfig",
      "description": "System configuration documents"
    }
  }
}
